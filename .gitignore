node_modules/
.pnpm-store/
.vitest/
*.tsbuildinfo
coverage/

# Rust
target/

# Benchmarks: asv environments, caches and generated data; results and site until M1 picks their home
.asv/
results/
site/
# asv's mirror clones of the upstream repositories
asv/*/

# The Accelerate solver library, which bwbench.solvers compiles beside its source.
*.dylib
