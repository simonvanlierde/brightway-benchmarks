// Renovate, not Dependabot: one bot for every ecosystem here, with the benchmark pins
// switched off. No automerge.
//
// Benchmark pins are moved by hand, never by a bot: asv/*.json, asv/*.stack.txt, the
// cutoff in scripts/in-box.sh, the asv and asv_runner versions in scripts/asv.sh, and the
// box image's digest in docker/Dockerfile (it fixes the Python every result ran on).
// Moving any of them changes every result (README, "How the results stay reproducible").
// Of those, only asv/ and the Dockerfile sit where a Renovate manager looks.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'Europe/Amsterdam',
  schedule: ['before 9am on monday'],
  // Hold a version back until it has been public for a week, long enough for a
  // compromised release to be caught and yanked. Security updates ignore it.
  minimumReleaseAge: '7 days',
  // Off by default in Renovate; the hooks in .pre-commit-config.yaml run under prek.
  'pre-commit': { enabled: true },
  ignorePaths: ['asv/**'],
  packageRules: [
    { matchFileNames: ['docker/Dockerfile'], enabled: false },
    { matchManagers: ['github-actions'], groupName: 'actions' },
    { matchManagers: ['pre-commit'], groupName: 'hooks' },
    // Dev tooling lands as one PR. A runtime dependency gets its own, so a risky bump
    // is not buried in lint-tool churn.
    {
      matchManagers: ['pep621'],
      matchDepTypes: ['dependency-groups'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'dev tooling',
    },
    { matchManagers: ['pep621'], matchUpdateTypes: ['major'], minimumReleaseAge: '30 days' },
  ],
}
