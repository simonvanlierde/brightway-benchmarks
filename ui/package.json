{
  "name": "benchmark-ui",
  "version": "0.0.0",
  "private": true,
  "description": "A static benchmark UI that reads an index and Bencher Metric Format reports",
  "license": "BSD-3-Clause",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "types": "json2ts --no-additionalProperties -i schema/index.schema.json -o src/lib/index.gen.ts && json2ts -i schema/report.schema.json -o src/lib/report.gen.ts && json2ts -i schema/guidance.schema.json -o src/lib/guidance.gen.ts && node scripts/generate-validators.mjs && biome format --write src/lib",
    "check": "biome check . && astro check && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "fmt": "biome check --write .",
    "size": "node scripts/size.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/svelte": "9.1.2",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "astro": "7.4.5",
    "json-schema-to-typescript": "16.0.0",
    "pagefind": "1.6.0",
    "smol-toml": "1.9.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
