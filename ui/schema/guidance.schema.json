{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/benchmark-ui/guidance.schema.json",
  "title": "Guidance",
  "description": "Optional setup, compatibility and measured comparison evidence for a benchmark project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "title", "intro", "snapshot", "platforms", "checks"],
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "run"],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://[^\\s]+$"
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "defaultCheck": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "python", "label", "kind", "status", "coverage", "caveats", "run"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "python": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["smoke", "suites", "diagnostic"]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://[^\\s]+$"
          },
          "lastPassed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "run", "packages", "files"],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https?://[^\\s]+$"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "files": {
                "description": "Primary download first.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "url"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^https?://[^\\s]+$"
                    }
                  }
                }
              },
              "install": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "solverComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "context", "rows"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "description": "The platform id the timings were measured on; other platforms show a caveat.",
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "unit", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(https?://[^\\s]+|\\?[^\\s]*)$"
              }
            }
          }
        }
      }
    }
  }
}
