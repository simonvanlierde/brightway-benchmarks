{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/benchmark-ui/guidance.schema.json",
  "title": "Guidance",
  "description": "Optional setup, compatibility and measured comparison evidence for a benchmark project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "title", "intro", "snapshot", "platforms", "checks"],
  "properties": {
    "format_version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "run"],
      "properties": {
        "date": {
          "type": "string",
          "minLength": 1,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "run": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://[^\\s]+$"
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "defaultCheck": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "platform", "python", "label", "kind", "status", "coverage", "caveats", "run"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "python": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "description": "What the labelled check installs and tests.",
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["smoke", "suites", "diagnostic"]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "coverage": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "run": {
            "type": "string",
            "minLength": 1,
            "pattern": "^https?://[^\\s]+$"
          },
          "lastPassed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "run", "packages", "files", "installs"],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 1,
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "run": {
                "type": "string",
                "minLength": 1,
                "pattern": "^https?://[^\\s]+$"
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "pinned": {
                "description": "The date of the set the URLs name; a later passing check of the same set keeps it. Present when files and installs also name the address that follows the newest set (their latest).",
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "files": {
                "description": "The files of the set, the package managers' own first.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "url"],
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^https?://[^\\s]+$"
                    },
                    "latest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^https?://[^\\s]+$"
                    }
                  }
                }
              },
              "installs": {
                "description": "One command per package manager that installs this set, reading its file from the URL.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["manager", "command"],
                  "properties": {
                    "manager": { "enum": ["uv", "pip", "conda", "pixi"] },
                    "command": { "type": "string", "minLength": 1 },
                    "latest": {
                      "description": "The same command at the address that follows the newest passing set.",
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "pythonSupport": {
      "description": "Whether each package installs, imports and scores on each Python and platform, from the latest run of each.",
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "endOfLife", "results"],
      "properties": {
        "packages": {
          "description": "The packages checked, in display order.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "endOfLife": {
          "description": "The Pythons past end of life, which a maintainer view lists apart from the supported ones.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["python", "platform", "package", "status", "date", "run"],
            "properties": {
              "python": { "type": "string", "minLength": 1 },
              "platform": { "type": "string", "minLength": 1 },
              "package": { "type": "string", "minLength": 1 },
              "status": {
                "description": "`undeclared` is no failure: no release of the package declares this Python.",
                "enum": ["pass", "fail", "undeclared"]
              },
              "reason": {
                "description": "Why it failed; present when status is fail.",
                "type": "string",
                "minLength": 1
              },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "run": { "type": "string", "minLength": 1, "pattern": "^https?://[^\\s]+$" }
            }
          }
        }
      }
    },
    "solverComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "context", "rows"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "description": "The platform id the timings were measured on; other platforms show a caveat.",
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "unit", "href"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(https?://[^\\s]+|\\?[^\\s]*)$"
              }
            }
          }
        }
      }
    }
  }
}
