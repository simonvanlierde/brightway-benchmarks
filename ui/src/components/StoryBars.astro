---
// A static bar chart: one row per measurement, each linking to its view in the viewer.
interface Row {
  label: string;
  seconds: number;
  href: string;
  tone: "fast" | "mid" | "base";
}
interface Props {
  rows: Row[];
  caption: string;
}
const { rows, caption } = Astro.props;
const longest = Math.max(...rows.map((row) => row.seconds));
const time = (s: number) => `${s >= 10 ? s.toPrecision(3) : s.toFixed(2)} s`;
---

<figure class="bars">
  <figcaption>{caption}</figcaption>
  <ul>
    {
      rows.map((row) => (
        <li>
          <a href={row.href}>
            <span class="row-head">
              <span>{row.label}</span>
              <strong>{time(row.seconds)}</strong>
            </span>
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <rect class="track" width="100" height="10" />
              <rect class={`fill ${row.tone}`} width={(row.seconds / longest) * 100} height="10" />
            </svg>
          </a>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .bars {
    margin: 20px 0;
  }
  figcaption {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  a {
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  a:hover .row-head span,
  a:focus-visible .row-head span {
    text-decoration: underline;
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 3px;
  }
  .row-head strong {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  svg {
    display: block;
    width: 100%;
    height: 14px;
  }
  .track {
    fill: var(--grid);
  }
  .fast {
    fill: var(--better);
  }
  .mid {
    fill: var(--s1);
  }
  .base {
    fill: var(--s2);
  }
</style>
