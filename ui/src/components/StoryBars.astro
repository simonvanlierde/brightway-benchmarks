---
// A static bar chart: one row per measurement, and optionally one link to the chart's view in the viewer.
interface Row {
  label: string;
  value: number;
  /** The solver's series colour, 1 to 8, as the viewer's charts draw it (lib/story-series.ts); none is neutral. */
  series?: number;
}
interface Props {
  rows: Row[];
  caption: string;
  href?: string;
  linkText?: string;
  /** How a value reads; seconds by default. */
  format?: (value: number) => string;
}
const seconds = (s: number) => `${s >= 10 ? s.toPrecision(3) : s.toFixed(2)} s`;
const { rows, caption, href, linkText = "Open in the viewer", format = seconds } = Astro.props;
const longest = Math.max(...rows.map((row) => row.value));
---

<figure class="bars">
  <figcaption>{caption}</figcaption>
  {href && <a class="open" href={href}>{linkText}<span class="sr">: {caption}</span></a>}
  <ul>
    {
      rows.map((row) => (
        <li>
            <span class="row-head">
              <span>{row.label}</span>
              <strong>{format(row.value)}</strong>
            </span>
            <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false">
              <rect class="track" width="100" height="10" />
<rect class:list={["fill", row.series ? `s${row.series}` : "neutral"]} width={(row.value / longest) * 100} height="10" />
            </svg>
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .bars {
    margin: 20px 0;
  }
  figcaption {
    color: var(--ink-2);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .open {
    display: inline-block;
    margin-bottom: 10px;
    font-size: 0.9rem;
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 3px;
  }
  .row-head strong {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  svg {
    display: block;
    width: 100%;
    height: 14px;
  }
  .track {
    fill: var(--grid);
  }
  /* A bar without a solver: neutral. Dark: --control is brighter than the series; this stays dimmer, 3.3:1 on the track. */
  .neutral {
    fill: var(--control);
  }
  :global(:root[data-theme="dark"]) .neutral {
    fill: #7488b3;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .neutral {
      fill: #7488b3;
    }
  }
  /* The page's policy blocks style attributes, so each series colour is a class. */
  .s1 { fill: var(--s1); }
  .s2 { fill: var(--s2); }
  .s3 { fill: var(--s3); }
  .s4 { fill: var(--s4); }
  .s5 { fill: var(--s5); }
  .s6 { fill: var(--s6); }
  .s7 { fill: var(--s7); }
  .s8 { fill: var(--s8); }
</style>
