---
// The shell for static pages (About, stories): the viewer's brand, main navigation and footer links, no JavaScript.
import LogoMark from "../components/LogoMark.svelte";
import "../styles.css";
import Head from "../pages/_Head.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageAlt?: string;
  mainClass: string;
}
const { mainClass, ...head } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/ui\/$/, "");
const repository = "https://github.com/simonvanlierde/brightway-benchmarks";
---

<html lang="en">
  <head>
    <Head {...head} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <header class="top">
      <div class="top-inner">
        <a class="static-brand" href={home}><LogoMark size={24} /><span>Brightway Benchmarks</span></a>
        <nav class="primary-nav" aria-label="Main">
          <a href={home}>Setup</a>
          <a href={`${home}?page=explorer`}>Benchmarks</a>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch to dark theme" title="Switch to dark theme">
          <svg data-theme-icon="sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/></svg>
          <svg data-theme-icon="moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z"/></svg>
        </button>
      </div>
    </header>
    <main class={mainClass} id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Project">
        <a href={`${repository}/blob/main/docs/method.md`}>Method</a>
        <a href="https://doi.org/10.5281/zenodo.23727602">Cite</a>
        <a href={repository}>GitHub</a>
        <a href={`${home}stories/solver-choice/`}>Solver story</a>
        <a href={`${home}about/`}>About &amp; privacy</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .top-inner > .theme-toggle {
    margin-left: auto;
  }
  .static-brand {
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }
</style>
