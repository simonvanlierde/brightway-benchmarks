---
// The shell for static pages (About, stories): the viewer's brand, main navigation and footer links, no JavaScript.
import Masthead from "../components/Masthead.svelte";
import "../styles.css";
import { STATIC_PAGES, type StaticPageId, staticHref, VIEWER_PAGES, viewerHref } from "../lib/pages";
import Head from "../pages/_Head.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  imageAlt?: string;
  mainClass: string;
  /** This page, as the nav and the footer name it. */
  current: StaticPageId;
}
const { mainClass, current, ...head } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/ui\/$/, "");
const repository = "https://github.com/simonvanlierde/brightway-benchmarks";
---

<html lang="en">
  <head>
    <Head {...head} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <Masthead
      name="Brightway Benchmarks"
      {home}
      links={[
        ...VIEWER_PAGES.map(({ id, text }) => ({ href: viewerHref(home, id), text, current: false })),
        { href: staticHref(home, current), text: STATIC_PAGES.find((p) => p.id === current)?.text ?? "", current: true },
      ]}
    />
    <main class={`static-page ${mainClass}`} id="main" tabindex="-1">
      <slot />
      <p class="back"><a href={home}>Back to Setup</a>, where the tested install sets are.</p>
    </main>
    <footer class="site-footer">
      <nav aria-label="Project">
        <a href={`${repository}/blob/main/docs/method.md`}>Method</a>
        <a href="https://doi.org/10.5281/zenodo.23727602">Cite</a>
        <a href={repository}>GitHub</a>
        {STATIC_PAGES.map((p) => (
          <a href={staticHref(home, p.id)} aria-current={current === p.id ? "page" : undefined}>{p.footer}</a>
        ))}
      </nav>
    </footer>
  </body>
</html>

<style>
  /* One measure for every static page, centred in the frame; its tables run the same width. */
  :global(.static-page) {
    max-width: 46rem;
    margin: 0 auto;
    padding: 40px 24px 64px;
  }
  :global(.static-page) :where(p, ul, ol, dl) {
    max-width: none;
  }
  :global(.static-page) .back {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  :global(.top-inner > .theme-toggle) {
    margin-left: 0;
  }
  :global(.top-inner > .masthead-search) {
    margin-left: auto;
  }
  /* Global: the masthead is a component. Three page links do not fit beside the icons at 320px, and these pages have no script to scroll them into view. */
  @media (max-width: 39rem) {
    :global(.top-inner > .primary-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
      margin: 0;
    }
    :global(.top-inner > .masthead-search) {
      grid-row: 3;
    }
  }
  :global(.static-brand) {
    grid-column: 1;
    grid-row: 1;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }
</style>
