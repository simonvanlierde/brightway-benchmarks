---
import { parse } from "smol-toml";
import findingsToml from "../../../benchmarks/findings.toml?raw";
import { compiledContent } from "../../../docs/findings.md";
import StaticPage from "../layouts/StaticPage.astro";
import { published } from "../lib/build-data";
import { viewerHref } from "../lib/story-links";

interface Finding {
  title: string;
  text: string;
  doc: string;
  group?: string;
  benchmark?: string;
  params?: Record<string, string>;
  profile?: string;
  story?: string;
}

const home = import.meta.env.BASE_URL.replace(/ui\/$/, "");
const repository = "https://github.com/simonvanlierde/brightway-benchmarks";
const findings = (parse(findingsToml) as unknown as { findings: Finding[] }).findings;
// findings.toml lists params in axis order, none skipped; scripts/export_ui.py fails the export otherwise.
// No history link until the data has the benchmark: the viewer would only say it is not there.
const view = (f: Finding) =>
  f.group && f.benchmark && published(f.group, f.benchmark)
    ? viewerHref(home, f.group, f.benchmark, Object.values(f.params ?? {}))
    : undefined;
const profile = (value: string) =>
  value.startsWith("https://") ? value : `${home}profiles/${value.replace(/^profiles\//, "")}`;
const story = (f: Finding) => `${home}stories/${f.story}/`;
const attr = (s: string) => s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll('"', "&quot;");

// docs/findings.md is the write-up, rendered here in full. Its title gives way to the page's own;
// its links to the repository's files (method.md, ../benchmarks/...) open on GitHub.
let section = "Findings";
let count = 0;
let doc = (await compiledContent())
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, "")
  .replace(
    /href="(?!https?:|#|mailto:)([^"]+)"/g,
    (_, rel) => `href="${new URL(rel, `${repository}/blob/main/docs/`)}"`,
  )
  // A link to a viewer history the data does not have keeps its words, without the link.
  .replace(/<a href="([^"]*[?&](?:amp;)?bench=[^"]*)">([\s\S]*?)<\/a>/g, (link, href: string, words: string) => {
    const q = new URL(href.replaceAll("&amp;", "&"), "https://x.invalid/").searchParams;
    const [group, bench] = [q.get("group"), q.get("bench")];
    return group && bench && !published(group, bench)
      ? `${words} <span class="quiet">(not published yet)</span>`
      : link;
  })
  // A wide table scrolls in its own box, as the viewer's do, so the page never scrolls sideways.
  // Each box is named after its section, so no two regions share a label.
  .replace(/<h[23] id="[^"]*">([\s\S]*?)<\/h[23]>|<table>/g, (match, heading) => {
    if (heading !== undefined) {
      section = heading.replace(/<[^>]+>/g, "");
      count = 0;
      return match;
    }
    count += 1;
    const name = `${section.replaceAll('"', "&quot;")}, table${count > 1 ? ` ${count}` : ""}`;
    return `<div class="scroll" role="region" tabindex="0" aria-label="${name}"><table>`;
  })
  .replace(/<\/table>/g, "</table></div>");
const at = (f: Finding) => doc.indexOf(`<h3 id="${f.doc}"`);
const missing = findings.filter((f) => at(f) < 0).map((f) => f.doc);
if (missing.length)
  throw new Error(`findings.toml: no section in docs/findings.md with the anchor ${missing.join(", ")}`);

// Under each finding's section heading, the links the headline card has.
for (const f of findings) {
  const links = [
    view(f) && `<a href="${attr(view(f) ?? "")}">Open the history</a>`,
    f.story && `<a href="${story(f)}">Read the story</a>`,
    f.profile && `<a href="${attr(profile(f.profile))}">Profile</a>`,
  ].filter(Boolean);
  doc = doc.replace(
    new RegExp(`<h3 id="${f.doc}"[^>]*>[\\s\\S]*?</h3>`),
    // A function, so a "$" in a link is not read as a replacement pattern.
    (heading) => `${heading}<p class="finding-links" data-pagefind-ignore>${links.join("")}</p>`,
  );
}

// Each package is a top-level section of the write-up; a headline goes under the one its section is in.
const headings = (tag: "h2" | "h3") =>
  [...doc.matchAll(new RegExp(`<${tag} id="([^"]+)"[^>]*>([\\s\\S]*?)</${tag}>`, "g"))].map((m) => ({
    id: m[1] ?? "",
    name: (m[2] ?? "").replace(/<[^>]+>/g, ""),
    at: m.index,
  }));
const packages = headings("h2");
const packageOf = (f: Finding) => packages.findLast((p) => p.at < at(f));
// The sidebar: every write-up section under its package.
const sections = headings("h3");
const outline = packages.map((p, i) => ({
  ...p,
  sections: sections.filter((s) => s.at > p.at && s.at < (packages[i + 1]?.at ?? Number.POSITIVE_INFINITY)),
}));
const headlines = packages
  .map((p) => ({ ...p, findings: findings.filter((f) => packageOf(f) === p).sort((a, b) => at(a) - at(b)) }))
  .filter((p) => p.findings.length);
---

<StaticPage
  mainClass="findings-page"
  current="findings"
  title="What the benchmarks found · Brightway Benchmarks"
  description="Every finding from the Brightway benchmarks, each with the history that shows it, its write-up and, where one exists, the story that tells it in full."
  canonical="https://simonvanlierde.com/brightway-benchmarks/findings/"
  image="findings.png"
  imageAlt="Bar chart: one bw2calc IterativeLCA score took 45.0 s with 3.0.0 and 9.04 s with 3.1.0."
>
  <div class="findings-layout">
  <nav class="findings-rail" aria-label="Findings">
    <a href="#headlines-heading">Headlines</a>
    {outline.map((p) => (
      <div class="rail-package">
        <a class="rail-package-name" href={`#${p.id}`}>{p.name}</a>
        {p.sections.length > 0 && (
          <ul aria-label={p.name}>
            {p.sections.map((x) => <li><a href={`#${x.id}`}>{x.name}</a></li>)}
          </ul>
        )}
      </div>
    ))}
  </nav>
  <div class="findings-content">
  <h1>What the benchmarks found</h1>
  <p class="lede">The headlines come first, grouped by package. Each opens its story where it has one, or its write-up, which says how it was measured and how to rerun it.</p>

  <div class="findings-main">
  <section class="headlines" aria-labelledby="headlines-heading">
    <h2 id="headlines-heading">Headlines</h2>
    {headlines.map((p) => (
      <div class="headline-group">
        <h3>{p.name}</h3>
        <ol class="finding-list">
          {p.findings.map((f) => (
            <li>
              <h4><a href={f.story ? story(f) : `#${f.doc}`}>{f.title}</a></h4>
              <p>{f.text}</p>
              <p class="finding-links" data-pagefind-ignore>
                {f.story && <a href={`#${f.doc}`}>Write-up<span class="sr"> on {f.title}</span></a>}
                {view(f) && <a href={view(f)}>Open the history<span class="sr"> for {f.title}</span></a>}
                {f.profile && <a href={profile(f.profile)}>Profile<span class="sr"> for {f.title}</span></a>}
              </p>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>

  <nav class="writeup-nav" aria-label="Write-ups by package">
    <span>Write-ups:</span>
    {packages.map((p) => <a href={`#${p.id}`}>{p.name}</a>)}
  </nav>
  <article class="writeups" set:html={doc} />
  </div>
  </div>
  </div>
</StaticPage>

<style>
  .headlines {
    margin-top: 32px;
  }
  .headlines > h2 {
    font-size: 1.35rem;
    margin: 0 0 4px;
  }
  /* A ledger: the package in the left column, its headlines beside it. */
  .headline-group {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0 24px;
    border-top: 1px solid var(--line);
  }
  .headline-group h3 {
    font-size: var(--text-evidence);
    font-weight: 650;
    color: var(--ink-2);
    margin: 0;
    padding-top: 22px;
    overflow-wrap: anywhere;
  }
  .finding-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .finding-list li {
    padding: 20px 0 8px;
  }
  .finding-list li + li {
    border-top: 1px solid var(--grid);
  }
  .finding-list h4 {
    font-size: 1.1rem;
    line-height: 1.3;
    text-wrap: balance;
    margin: 0 0 6px;
  }
  .finding-list p {
    margin: 0 0 10px;
    font-size: var(--text-evidence);
    line-height: 1.6;
  }
  /* Global: the write-up's link lines come from set:html, which Astro does not scope. */
  .findings-main :global(.finding-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: var(--text-evidence);
  }
  .finding-list .finding-links {
    margin: -6px 0 0;
  }
  .findings-main :global(.finding-links a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .writeup-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
    margin: 48px 0 0;
    padding: 6px 0;
    border-block: 1px solid var(--line);
    font-size: var(--text-evidence);
  }
  .writeup-nav span {
    color: var(--ink-2);
    font-weight: 650;
  }
  .writeup-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  /* Wide screens: a sticky outline of the write-ups beside the page, as Benchmarks has its catalogue. */
  .findings-rail {
    display: none;
  }
  @media (min-width: 70rem) {
    :global(.static-page.findings-page) {
      max-width: 70rem;
    }
    .findings-layout {
      display: grid;
      grid-template-columns: 15rem minmax(0, 46rem);
      gap: 48px;
    }
    .findings-rail {
      display: block;
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100vh;
      overflow-y: auto;
      padding: 8px 0 24px;
      font-size: 0.875rem;
      line-height: 1.4;
    }
    .findings-rail a {
      display: block;
      padding: 5px 0;
      color: var(--ink-2);
      text-decoration: none;
    }
    .findings-rail a:hover {
      color: var(--accent);
      text-decoration: underline;
    }
    .findings-rail > a,
    .rail-package-name {
      font-weight: 700;
      color: var(--ink);
    }
    .rail-package {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
    }
    .findings-rail ul {
      list-style: none;
      margin: 0;
      padding: 0 0 0 12px;
    }
    .writeup-nav {
      display: none;
    }
  }
  @media (max-width: 39rem) {
    .headline-group {
      grid-template-columns: minmax(0, 1fr);
    }
    .headline-group h3 {
      padding-top: 16px;
    }
    .finding-list li {
      padding-top: 10px;
    }
  }
  .writeups {
    margin-top: 24px;
  }
  .writeups :global(h2) {
    font-size: 1.35rem;
    margin: 48px 0 0;
    padding-top: 16px;
    border-top: 2px solid var(--ink);
  }
  .writeups :global(h3) {
    font-size: 1.2rem;
    line-height: 1.4;
    margin: 40px 0 12px;
  }
  .writeups :global(:is(h2, h3)) {
    scroll-margin-top: 24px;
  }
  .writeups :global(h3 + .finding-links) {
    margin: -4px 0 4px;
  }
  .writeups :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-evidence);
    margin: 0 0 16px;
  }
  .writeups :global(:is(th, td)) {
    text-align: left;
    padding: 6px 16px 6px 0;
    border-bottom: 1px solid var(--grid);
    vertical-align: top;
    line-height: 1.6;
  }
  .writeups :global(th) {
    border-bottom-color: var(--line);
  }
  /* The target of a headline's "Write-up" link: its heading, marked once you land. */
  .writeups :global(h3:target) {
    background: var(--accent-wash);
    margin-inline: -8px;
    padding-inline: 8px;
  }
</style>
