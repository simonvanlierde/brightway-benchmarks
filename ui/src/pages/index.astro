---
import App from "../components/App.svelte";
import "../styles.css";

const base = import.meta.env.PUBLIC_DATA_URL ?? "data/";
const assetBase = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>Benchmarks</title>
    <meta
      name="description"
      content="Tested platform setups and continuous benchmark evidence for the Brightway LCA stack."
    />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <link rel="icon" href={`${assetBase}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${assetBase}apple-touch-icon.png`} />
    <meta property="og:title" content="Brightway Benchmarks" />
    <meta
      property="og:description"
      content="Tested platform setups and continuous benchmark evidence for the Brightway LCA stack."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${assetBase}og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <App client:only="svelte" base={base} />
  </body>
</html>
