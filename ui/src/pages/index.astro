---
import { execFileSync } from "node:child_process";
import App from "../components/App.svelte";
import Masthead from "../components/Masthead.svelte";
import SetupIntro from "../components/SetupIntro.svelte";
import { setupIntro } from "../lib/build-data";
import "../styles.css";
import { staticHref, VIEWER_PAGES, viewerHref } from "../lib/pages";
import Head from "./_Head.astro";

const base = import.meta.env.PUBLIC_DATA_URL ?? "data/";
const data = base.endsWith("/") ? base : `${base}/`;
const repository = "https://github.com/simonvanlierde/brightway-benchmarks";
const git = (...args: string[]) => {
  try {
    return execFileSync("git", args, { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    return "";
  }
};
const sha = git("rev-parse", "--short=7", "HEAD");
const tag = git("describe", "--tags", "--exact-match", "HEAD");
const branch = process.env.GITHUB_REF_NAME ?? git("branch", "--show-current");
const released = /^v\d+\.\d+\.\d+$/.test(tag);
const build = {
  label: released ? tag : sha ? `${branch === "main" ? "main" : "dev"} · ${sha}` : "development",
  url: released ? `${repository}/releases/tag/${tag}` : sha ? `${repository}/commit/${sha}` : repository,
};
const home = import.meta.env.BASE_URL.replace(/ui\/$/, "");
const intro = setupIntro();
---

<html lang="en">
  <head>
    <Head
      title="Tested setups and release histories · Brightway Benchmarks"
      description="Choose a tested Brightway installation and explore performance across package releases, with calculation checks and measurement noise beside the results."
      canonical="https://simonvanlierde.com/brightway-benchmarks/"
    />
    {/* Fetched while the viewer's script loads; `crossorigin` matches fetch()'s mode, so it reuses them. */}
    <link rel="preload" as="fetch" crossorigin href={`${data}index.json`} />
    <link rel="preload" as="fetch" crossorigin href={`${data}guidance.json`} />
  </head>
  <body>
    <App client:only="svelte" base={base} build={build} {home} {intro}>
      {/* The viewer's masthead, drawn before its script runs, so a page change does not flash an empty page. */}
      <Fragment slot="fallback">
      <Masthead
        name="Brightway Benchmarks"
        home={import.meta.env.BASE_URL}
        links={[
          ...VIEWER_PAGES.map(({ id, text }) => ({ href: viewerHref(home, id), text, current: false })),
          { href: staticHref(home, "findings"), text: "Findings", current: false },
        ]}
        search={{ value: "", open: false, toggle: () => {}, input: () => {}, submit: () => {} }}
      />
      {/* Setup's heading and intro, drawn with the page, so a phone shows them before the script and the data arrive. */}
      {intro && (
        <div class="frame fullwidth">
          <div class="view"><div class="home-columns"><div class="setup-column"><SetupIntro {...intro} /></div></div></div>
        </div>
      )}
      {/* The same rule as pageOf in lib/history.ts: any other page drops it before it is drawn. */}
      {intro && (
        <script is:inline>
          (() => {
            const q = new URLSearchParams(location.search);
            const page = q.get("page");
            const other = q.has("bench") || page === "explorer" || page === "changes" || (!page && (q.has("group") || q.has("direction")));
            if (other) document.currentScript.previousElementSibling.remove();
          })();
        </script>
      )}
      </Fragment>
    </App>
    <noscript>
      <main class="view">
        {!intro && <h1>Brightway benchmarks</h1>}
        <p>Tested installation sets and performance histories for the Brightway life cycle assessment stack.</p>
        <p>Enable JavaScript to select setups and explore charts, or read <a href={staticHref(home, "about")}>about the benchmarks</a> and the <a href={`${repository}/blob/main/docs/method.md`}>measurement method</a>.</p>
      </main>
    </noscript>
  </body>
</html>
